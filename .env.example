# ─────────────────────────────────────────────────────────────────────
# School portal — environment settings
# Copy to .env and fill in. Never commit the real .env.
# ─────────────────────────────────────────────────────────────────────

# ── The school ──
SCHOOL_NAME=Intercontinental School Kano
SCHOOL_SLUG=intercontinental
SCHOOL_PHONE=

# ── Django ──
# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=False
# The portal's domain (www. redirects to it in nginx)
ROOT_DOMAIN=intercontinentalschools.com.ng
ALLOWED_HOSTS=intercontinentalschools.com.ng,www.intercontinentalschools.com.ng
# Optional; defaults to https://ROOT_DOMAIN
SITE_URL=https://intercontinentalschools.com.ng
# Local development only:
# ROOT_DOMAIN=localhost
# DEV_PORT=8000
# DEBUG=True

# ── Database ──
# SQLite: keep the file OUTSIDE the code folder so deploys never touch it.
DB_ENGINE=sqlite
SQLITE_PATH=/srv/intercontinental/data/db.sqlite3
# To move to PostgreSQL later: DB_ENGINE=postgresql and fill these in
# DB_NAME=school
# DB_USER=school
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# ── Files (outside the code folder) ──
STATIC_ROOT=/srv/intercontinental/static
MEDIA_ROOT=/srv/intercontinental/media
PRIVATE_MEDIA_ROOT=/srv/intercontinental/private_media
# nginx sends private files after Django has checked permission (see deploy/nginx.conf)
SIGNED_MEDIA_ACCEL=/protected-media/

# ── Backups (python manage.py backup_database) ──
BACKUP_DIR=/srv/intercontinental/backups
BACKUP_KEEP_DAYS=14

# Optional shared cache for several Gunicorn workers
# REDIS_URL=redis://127.0.0.1:6379/1

# ── Email (the school's own mailbox / SMTP) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# EMAIL_FROM_NAME=Intercontinental School Kano
# Where server errors and security alerts go
ADMIN_EMAIL=
# IT_ALERT_EMAILS=ict@school.edu.ng,principal@school.edu.ng
# SECURITY_CONTACT_EMAIL=

# ── Payments: the school's own Paystack account (fees, admission forms) ──
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── SMS: the school's own provider account ──
TERMII_API_KEY=
TERMII_SENDER_ID=
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
SMS_ENABLED=True
SMS_METERING=False

# ── WhatsApp Business (optional) ──
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=

# ── AI assistant (optional; the school's own keys) ──
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_DEFAULT_PROVIDER=openai

# ── Security ──
# Encrypts medical, counselling and safeguarding notes. Generate once and keep a safe copy:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
TWO_FACTOR_ENFORCE=True
